<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SMS.Infrastructure — EF Core, PostgreSQL, tenancy, the clock, the startup schema check.
    Implements the interfaces that Application declares.

      May reference:      Application (and Domain through it).
      Must not reference: Web, Api.

    Everything that knows what a database is belongs here and nowhere above it. Both
    migration histories live here too, and every "dotnet ef" command must name the context
    explicitly — there are two, and the wrong one silently targets the wrong schema.

    UserSecretsId is shared with both hosts on purpose: the design-time factories used by
    "dotnet ef" read the Owner connection string from the same store the applications read
    the App one from, so a machine is configured once (PROJECT_STATUS section 2).
  -->

  <PropertyGroup>
    <UserSecretsId>4a4b251b-307d-4933-b84e-29e4e4f64e49</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SMS.Application\SMS.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>

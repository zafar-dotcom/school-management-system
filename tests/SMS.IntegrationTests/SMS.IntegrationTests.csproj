<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests against a real PostgreSQL — the sms_test database, via ConnectionStrings:TestOwner.

    These exist because the properties this product depends on cannot be tested any other
    way: the global branch filter, the cross-schema foreign key, the two-role grants, and
    tenant resolution refusing a stale membership. The in-memory provider does not enforce
    any of them (architecture section 8).

    Never point these at the sms database. They create and destroy data.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SMS.Infrastructure\SMS.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SMS.Web\SMS.Web.csproj" />
  </ItemGroup>

</Project>

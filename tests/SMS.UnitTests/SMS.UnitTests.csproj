<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fast tests with no database and no host: domain rules and application handlers against
    fakes of IMasterStore / ISchoolStore.

    Anything that needs to prove relational behaviour — the branch query filter, the
    cross-schema foreign key, the two-role grants — belongs in SMS.IntegrationTests
    instead. The EF Core in-memory provider cannot validate those, and a test that appears
    to cover isolation but does not is worse than no test (architecture section 8).
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SMS.Domain\SMS.Domain.csproj" />
    <ProjectReference Include="..\..\src\SMS.Application\SMS.Application.csproj" />
  </ItemGroup>

</Project>
